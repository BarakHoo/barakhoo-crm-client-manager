# Copy to .env and fill in real values. NEVER commit .env to source control.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=crmdb

# JWT signing secret - REQUIRED, must be at least 32 characters
APP_JWT_SECRET=

# First-boot admin bootstrap (big_boss). Password REQUIRED on first boot, min 8 chars.
APP_INITIAL_ADMIN_USERNAME=admin
APP_INITIAL_ADMIN_PASSWORD=

# Comma-separated CORS origins. Leave empty for same-origin only (production behind Caddy).
APP_CORS_ALLOWED_ORIGINS=

# API base the browser uses to reach the backend through the reverse proxy.
# On munkys.dev this app is served under /crm, so the API base is /crm/api.
# For a standalone deployment at root, use /api instead.
VITE_API_BASE=/crm/api
